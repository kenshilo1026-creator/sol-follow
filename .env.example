# Independent SOL service. Start in DRY_RUN; never shares RH/BSC wallets/DBs.
DRY_RUN=true

# Alchemy handles hotlist streaming and CEX/Privacy Cash source-history pagination.
# A key enables Alchemy-first history and execution HTTP.
# auto selects alchemy_grpc when a key is present, otherwise legacy websocket.
ALCHEMY_API_KEY=
# Funding logs use Alchemy WSS with this key when SOL_RPC_WS_URL is the public default.
# A custom SOL_RPC_WS_URL is preserved. Optional override (blank = automatic):
SOL_FUNDING_WS_URL=
# Execution defaults with a key: Alchemy HTTP primary + configured public HTTP fallback.
# Without a key: configured public HTTP. Explicit endpoint overrides take precedence.
# Separate connection pools share endpoint cooldowns; Alchemy quotas may be shared.
# Optional dedicated endpoints; blank keeps the defaults. Never paste secrets into logs.
SOL_EXECUTION_RPC_HTTP_URL=
SOL_EXECUTION_RPC_FALLBACK_HTTP_URL=
SOL_EXECUTION_RPC_WS_URL=
SOL_EXECUTION_RPC_TIMEOUT_MS=4000
# Start configured backup after this delay for buy simulation / signed broadcasts.
# 0 restores sequential fallback; fast primary responses use no extra request.
SOL_EXECUTION_HEDGE_MS=75
# Public background RPC budget. Trading priority pauses new background reads.
SOL_BACKGROUND_RPC_RPS=2
# Alchemy funding/source budget; execution reads have their own budget at this rate.
SOL_FUNDING_ALCHEMY_RPS=8
# Funding workers in alchemy_grpc mode; create stream retains its own worker.
SOL_FUNDING_WORKERS=4
SOL_FEED_MODE=alchemy_grpc
# Full transaction/meta at processed; legacy_websocket requires confirmed.
SOL_HOTLIST_COMMITMENT=processed

# Case-sensitive Solana addresses. Native SOL Privacy Cash only.
SOL_HOTLIST_SOURCE_CONTRACT=9fhQBbumKEFuXtMBDw8AaQyAjCorLGJQiS3skWZdQyQD
SOL_PRIVACY_POOL_ADDRESSES=4AV2Qzp3N4c9RfzyEbNZs2wqWfW4EwKnnxFAZCndvfGh
SOL_HOTLIST_MIN_FUNDING_SOL=0.01
SOL_HOTLIST_MAX_FUNDING_SOL=100
# CEX native USDC withdrawals, inclusive; 1 USDC treated as 1 USD (no price RPC).
SOL_HOTLIST_MIN_FUNDING_USDC=50
SOL_HOTLIST_MAX_FUNDING_USDC=800
# Hours; converted to seconds for chain timestamps and database expiry.
SOL_HOTLIST_TTL_HOUR=24
# Minutes since the latest qualified funding before create; 0 disables the age gate.
# 10 requires at least 10 minutes (boundary inclusive); 0.5 means 30 seconds.
# Applies to all Pump/Stonk creates, SOL/USDC CEX and Privacy Cash funding.
# A young-funding create consumes its hotlist and is skipped, never bought later.
SOL_BUY_ONLY_AGED_MINUTES=0
# CEX/Privacy Cash: count wallet-address signatures, including incoming/failed/current deposit.
# Above this cap rejects before fetching transaction details; equality continues the launch-history check.
SOL_MAX_PRELAUNCH_TX=10
SOL_BACKFILL_MAX_AGE_SECONDS=3600

# Hotlisted signing dev creates trigger an entry; no wallet-vote threshold.
SOL_SIGNAL_MAX_AGE_SECONDS=15
SOL_BUY_AMOUNT_SOL=0.01
# Total priority-fee budget per buy, sell and quote conversion; excludes base fee/tip.
SOL_PRIORITY_FEE_SOL=0.0002
# Use verified create/trade events for mint and pool state; keep simulation and minOut.
SOL_LOCAL_CREATE_BUILD=true
# Decide before buying from create calldata / already received transaction metadata.
# No getMultipleAccounts/getTokenAccountsByOwner for this quantity check.
# Strictly above this launch token quantity blocks entry; equality passes.
# Unknown quantity skips entry. Blank disables NEW quantity checks.
SOL_DEV_MAX_HOLDING_TOKENS=60000000
# Percent: 2 means 2%, 0.5 means 0.5%.
SOL_SLIPPAGE_PERCENT=20
SOL_MIN_POOL_LIQUIDITY_SOL=10
# Independent nominal transfer-tax caps for quote and target tokens (percent).
# Check current and already scheduled tax rates; strictly above rejects, equal passes.
# Pool/platform/protocol fees are quoted but have no admission cap.
SOL_MAX_QUOTE_TOKEN_TAX_PERCENT=3.9
SOL_MAX_TOKEN_TAX_PERCENT=3.9
# Price impact applies to routed/Stonk buys and background conversion.
# Background slippage = min(SLIPPAGE, MAX_PRICE_IMPACT percent).
# These are separate from the end-to-end NET token slippage above.
SOL_MAX_PRICE_IMPACT_PERCENT=2
# Persistent identities/routes; public websocket account updates, no HTTP polling.
# TTL applies to untracked snapshots / websocket heartbeat, not unchanged healthy accounts.
SOL_QUOTE_CACHE_TTL_MS=2000
SOL_QUOTE_CACHE_ACCOUNTS=512
# Shared blockhash background refresh pauses while trading. A miss skips the build.
SOL_BLOCKHASH_REFRESH_MS=1000
SOL_BLOCKHASH_CACHE_TTL_MS=5000

# Buyer wallet Base58 private key (64-byte keypair), NOT a public address.
# Public address is derived automatically. Required for LIVE; optional for DRY_RUN.
# DRY_RUN never signs or broadcasts, even when a private key is configured.
SOL_WALLET_ADDRESS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Combined DB/WAL/SHM soft capacity. Essential state is never evicted.
SOL_DB_MAX_BYTES=2147483648
SOL_DB_TARGET_BYTES=1610612736
SOL_MIN_DISK_FREE_BYTES=268435456
SOL_AUDIT_RETENTION_HOUR=72

# Rule percentages are profit over entry; sales use the remaining bot position.
# Per-position spot checks; after 30 minutes use 5x this interval (default 25s).
SOL_TAKE_PROFIT_POLL_SECONDS=5
SOL_TAKE_PROFIT_RULES_PATH=take_profit_rules.json
